# Environment Variables Configuration for X-Gun Memory
# Copy this file to .env and fill in your values

# Storage Configuration
STORAGE_TYPE=sqlite
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/database

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENABLED=true

# Server Configuration
MCP_PORT=3001
API_PORT=3000
API_HOST=localhost

# Logging
LOG_LEVEL=info

# Agent Configuration
DEFAULT_AGENT_ID=global

# Authentication
AUTH_ENABLED=true